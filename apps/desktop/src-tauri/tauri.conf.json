{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetExplorer Monitor",
  "version": "0.1.0",
  "identifier": "com.local.betexplorer.monitor",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "BetExplorer Monitor",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
